---
import { getInvitationBySlug } from '../../lib/directus';
import { mockInvitation } from '../../data/mock-invitation';
import { formatEventDate, formatEventTime, buildCalendarUrl } from '../../lib/invitation-utils';
import Cover from '../../components/templates/garden/Cover.astro';
import Hero from '../../components/templates/garden/Hero.astro';
import StorySection from '../../components/templates/garden/StorySection.astro';
import VerseSection from '../../components/templates/garden/VerseSection.astro';
import Venue from '../../components/templates/garden/Venue.astro';
import Schedule from '../../components/templates/garden/Schedule.astro';
import Gallery from '../../components/templates/garden/Gallery.astro';
import DressCode from '../../components/templates/garden/DressCode.astro';
import GiftSection from '../../components/templates/garden/GiftSection.astro';
import Footer from '../../components/templates/garden/Footer.astro';
import RsvpModal from '../../components/templates/garden/RsvpModal.astro';

const { slug } = Astro.params;
const slugStr = Array.isArray(slug) ? slug.join('/') : (slug ?? '');
let invitation = null;
try { invitation = await getInvitationBySlug(slugStr); } catch { /* fallback */ }
if (!invitation) invitation = mockInvitation;

const eventDate = formatEventDate(invitation.event_date_time);
const eventTime = formatEventTime(invitation.event_date_time);
const calendarUrl = buildCalendarUrl({
  eventDateTime: invitation.event_date_time,
  calendarDetails: invitation.calendar_details,
  venueAddress: invitation.venue_address,
});
const guestName = Astro.url.searchParams.get('to') ?? undefined;
---
<!doctype html>
<html lang="ms">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jemputan Perkahwinan — {invitation.couple_name_1} &amp; {invitation.couple_name_2}</title>
  <meta name="description" content={`Jemputan ke majlis perkahwinan ${invitation.couple_name_1} & ${invitation.couple_name_2} pada ${eventDate}.`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body { background: #FDF8F0; color: #3D3D3D; font-family: 'Lora', Georgia, serif; }
    .garden-panel { min-height: 100dvh; display: flex; flex-direction: column; justify-content: center; }
    /* Section navigation dots */
    .garden-nav-dots { position: fixed; right: 12px; top: 50%; transform: translateY(-50%); z-index: 50; display: flex; flex-direction: column; gap: 10px; }
    .garden-nav-dot { width: 10px; height: 10px; border-radius: 50%; background: rgba(143,169,138,0.35); border: none; cursor: pointer; padding: 0; transition: all 0.2s; }
    .garden-nav-dot:hover, .garden-nav-dot.active { background: var(--sage); transform: scale(1.3); }
    @media (max-width: 480px) { .garden-nav-dots { right: 6px; gap: 8px; } .garden-nav-dot { width: 8px; height: 8px; } }
  </style>
</head>
<body>
  <nav class="garden-nav-dots" aria-label="Section navigation">
    <button class="garden-nav-dot" data-target="cover" aria-label="Cover"></button>
    <button class="garden-nav-dot" data-target="hero" aria-label="Info"></button>
    <button class="garden-nav-dot" data-target="story" aria-label="Story"></button>
    <button class="garden-nav-dot" data-target="verse" aria-label="Verse"></button>
    <button class="garden-nav-dot" data-target="venue" aria-label="Venue"></button>
    <button class="garden-nav-dot" data-target="schedule" aria-label="Schedule"></button>
    <button class="garden-nav-dot" data-target="gallery" aria-label="Gallery"></button>
    <button class="garden-nav-dot" data-target="dresscode" aria-label="Dress Code"></button>
    <button class="garden-nav-dot" data-target="gift" aria-label="Gift"></button>
  </nav>
  <Cover bismillah={invitation.islamic_opening} coupleName1={invitation.couple_name_1} coupleName2={invitation.couple_name_2} eventDate={eventDate} />
  <Hero coupleName1={invitation.couple_name_1} coupleName2={invitation.couple_name_2} eventDateIso={invitation.event_date_time} calendarUrl={calendarUrl} />
  <StorySection story={invitation.story} coupleName1={invitation.couple_name_1} coupleName2={invitation.couple_name_2} />
  <VerseSection verse={invitation.verse_or_message} />
  <Venue venueName={invitation.venue_name} venueAddress={invitation.venue_address} googleMapsUrl={invitation.google_maps_url} wazeUrl={invitation.waze_url} eventDate={eventDate} eventTime={eventTime} />
  <Schedule schedule={invitation.schedule} />
  <Gallery photos={invitation.gallery} />
  <DressCode dressCode={invitation.dress_code} palette={invitation.dress_code_palette} />
  <GiftSection giftEnabled={invitation.gift_enabled} giftDetails={invitation.gift_details} qrCode={invitation.qr_code} />
  <Footer coupleName1={invitation.couple_name_1} coupleName2={invitation.couple_name_2} contactName={invitation.contact_name} contactPhone={invitation.contact_phone} />
  <RsvpModal invitationId={invitation.id} guestName={guestName} />
  <script>
    import { initGardenAnimations, coverOpen } from '../../lib/invitation-animations-garden';
    const heroEl = document.getElementById('hero');
    const eventDateIso = heroEl?.getAttribute('data-event-date') ?? '';
    initGardenAnimations(eventDateIso);
    document.getElementById('garden-open-btn')?.addEventListener('click', () => {
      coverOpen(() => { heroEl?.scrollIntoView({ behavior: 'smooth' }); });
    });
    // Nav dot click handlers
    document.querySelectorAll('.garden-nav-dot').forEach(dot => {
      dot.addEventListener('click', () => {
        const target = dot.getAttribute('data-target');
        if (!target) return;
        const el = document.getElementById(target);
        el?.scrollIntoView({ behavior: 'smooth' });
      });
    });
    // Active dot tracking on scroll
    const panels = ['cover','hero','story','verse','venue','schedule','gallery','dresscode','gift'];
    const dots = document.querySelectorAll('.garden-nav-dot');
    window.addEventListener('scroll', () => {
      let current = 0;
      panels.forEach((id, i) => {
        const el = document.getElementById(id);
        if (el && el.getBoundingClientRect().top <= window.innerHeight / 2) current = i;
      });
      dots.forEach((d, i) => d.classList.toggle('active', i === current));
    }, { passive: true });
  </script>
</body>
</html>
