---
/**
 * src/components/templates/songket/Schedule.astro
 * Vertical itinerary timeline with gold dot markers and connecting line.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  inv: Invitation;
}

const { inv } = Astro.props;
const schedule = inv.schedule ?? [];
---

{schedule.length > 0 && (
  <section class="schedule section-reveal" aria-label="Atur Cara Majlis">
    <div class="schedule-inner">
      <p class="schedule-label">Atur Cara</p>
      <h2 class="schedule-heading">Jadual Majlis</h2>

      <ol class="timeline stagger-reveal" aria-label="Jadual atur cara majlis">
        {schedule.map((item: { time: string; description: string }, i: number) => (
          <li class="timeline-item stagger-child">
            <div class="timeline-marker" aria-hidden="true">
              <span class="timeline-dot"></span>
              {i < schedule.length - 1 && <span class="timeline-line"></span>}
            </div>
            <div class="timeline-content">
              <time class="timeline-time">{item.time}</time>
              <p class="timeline-desc">{item.description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<style>
  .schedule {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.5rem, 6vw, 4rem);
    background: var(--deep-green);
  }

  .schedule-inner {
    max-width: 560px;
    margin: 0 auto;
  }

  .schedule-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--antique-gold);
    margin-bottom: 0.6rem;
  }

  .schedule-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: var(--ivory);
    font-weight: 600;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    line-height: 1.2;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .timeline-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .timeline-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    padding-top: 4px;
  }

  .timeline-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--antique-gold);
    box-shadow: 0 0 0 3px rgba(217, 184, 103, 0.22);
    flex-shrink: 0;
  }

  .timeline-line {
    flex: 1;
    width: 1px;
    min-height: 2.5rem;
    background: linear-gradient(to bottom, var(--antique-gold), rgba(217, 184, 103, 0.15));
    margin-top: 5px;
    margin-bottom: 5px;
  }

  .timeline-content {
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    flex: 1;
  }

  .timeline-time {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1rem, 2.5vw, 1.15rem);
    font-weight: 600;
    color: var(--light-gold);
    margin-bottom: 0.2rem;
  }

  .timeline-desc {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
