---
/**
 * src/components/templates/songket/Venue.astro
 * Venue card with glass morphism effect, venue name, address,
 * and side-by-side Google Maps & Waze navigation buttons.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  inv: Invitation;
}

const { inv } = Astro.props;
---

{(inv.venue_name || inv.venue_address) && (
  <section class="venue section-reveal" aria-label="Lokasi Majlis">
    <div class="venue-inner">
      <p class="venue-label">Lokasi Majlis</p>
      <h2 class="venue-heading">Jemputan Hadir</h2>

      <div class="venue-card">
        <div class="venue-card-icon" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/>
            <circle cx="12" cy="9" r="2.5"/>
          </svg>
        </div>

        {inv.venue_name && (
          <h3 class="venue-name">{inv.venue_name}</h3>
        )}

        {inv.venue_address && (
          <p class="venue-address">{inv.venue_address}</p>
        )}

        <div class="venue-actions">
          {inv.google_maps_url && (
            <a
              href={inv.google_maps_url}
              target="_blank"
              rel="noopener noreferrer"
              class="venue-btn venue-btn--maps"
              id="maps-btn"
              aria-label="Buka di Google Maps"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              Google Maps
            </a>
          )}
          {inv.waze_url && (
            <a
              href={inv.waze_url}
              target="_blank"
              rel="noopener noreferrer"
              class="venue-btn venue-btn--waze"
              id="waze-btn"
              aria-label="Buka di Waze"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.49.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 22 12 10 10 0 0 0 12 2z"/>
              </svg>
              Waze
            </a>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .venue {
    padding: clamp(3.5rem, 8vw, 6rem) 1.5rem;
    background: var(--midnight);
    text-align: center;
  }

  .venue-inner {
    max-width: 580px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
  }

  .venue-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--antique-gold);
  }

  .venue-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: var(--ivory);
    font-weight: 600;
    line-height: 1.2;
  }

  .venue-card {
    width: 100%;
    background: rgba(44, 106, 84, 0.12);
    border: 1px solid rgba(217, 184, 103, 0.22);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 4px;
    padding: clamp(1.75rem, 4vw, 2.5rem) clamp(1.25rem, 3vw, 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .venue-card-icon {
    color: var(--antique-gold);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(217, 184, 103, 0.1);
    border: 1px solid rgba(217, 184, 103, 0.25);
    flex-shrink: 0;
  }

  .venue-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(1.35rem, 4vw, 1.75rem);
    color: var(--ivory);
    font-weight: 600;
    margin: 0;
  }

  .venue-address {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
    text-align: center;
    max-width: 48ch;
  }

  .venue-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .venue-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.65em 1.4em;
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: filter 0.2s ease, transform 0.15s ease;
  }

  .venue-btn:hover {
    filter: brightness(1.12);
    transform: translateY(-1px);
  }

  .venue-btn:active {
    transform: translateY(0);
  }

  .venue-btn--maps {
    background: #4285F4;
    color: #ffffff;
  }

  .venue-btn--waze {
    background: #33CCFF;
    color: #071D18;
    font-weight: 600;
  }
</style>
