---
/**
 * src/components/templates/songket/RsvpModal.astro
 * Full-screen modal for guest RSVP submission with validation,
 * asynchronous POST to /api/rsvp, and celebration sparkle effect.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  inv: Invitation;
}

const { inv } = Astro.props;
---

<!-- Modal Backdrop & Dialog Container -->
<div
  class="rsvp-modal-backdrop"
  id="rsvp-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Borang Pengesahan Kehadiran (RSVP)"
  data-invitation-id={inv.id}
  hidden
>
  <div class="modal-panel">
    <!-- Close Button -->
    <button
      class="modal-close"
      id="close-rsvp-modal-btn"
      type="button"
      aria-label="Tutup borang RSVP"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Header -->
    <div class="modal-header">
      <p class="modal-label">Pengesahan Kehadiran</p>
      <h2 class="modal-heading">Hantar RSVP</h2>
      <p class="modal-subheading">
        Walimatulurus {inv.couple_name_1} &amp; {inv.couple_name_2}
      </p>
    </div>

    <!-- Success View (hidden until submitted) -->
    <div class="modal-success" id="rsvp-success" hidden aria-live="assertive">
      <div class="success-icon" id="sparkle-origin" aria-hidden="true">✦</div>
      <h3 class="success-heading">Terima Kasih!</h3>
      <p class="success-desc">RSVP anda telah selamat diterima. Kami amat menantikan kehadiran anda sekeluarga.</p>
    </div>

    <!-- Form -->
    <form class="rsvp-form" id="rsvp-form" novalidate>
      <div class="form-field">
        <label class="form-label" for="rsvp-name">Nama Penuh *</label>
        <input
          class="form-input"
          type="text"
          id="rsvp-name"
          name="guest_name"
          required
          minlength="2"
          placeholder="cth. Ahmad Faiz"
          autocomplete="name"
        />
        <span class="form-error" id="rsvp-name-error" role="alert" hidden></span>
      </div>

      <div class="form-field">
        <label class="form-label" for="rsvp-phone">No. Telefon (WhatsApp) *</label>
        <input
          class="form-input"
          type="tel"
          id="rsvp-phone"
          name="telephone"
          required
          placeholder="cth. 0123456789"
          autocomplete="tel"
        />
        <span class="form-error" id="rsvp-phone-error" role="alert" hidden></span>
      </div>

      <div class="form-field">
        <span class="form-label" id="rsvp-attendance-label">Status Kehadiran *</span>
        <div class="radio-group" role="radiogroup" aria-labelledby="rsvp-attendance-label">
          <label class="radio-option">
            <input type="radio" name="attendance_status" value="attending" checked required />
            <span class="radio-visual" aria-hidden="true"></span>
            Hadir
          </label>
          <label class="radio-option">
            <input type="radio" name="attendance_status" value="not_attending" />
            <span class="radio-visual" aria-hidden="true"></span>
            Tidak Dapat Hadir
          </label>
        </div>
        <span class="form-error" id="rsvp-attend-error" role="alert" hidden></span>
      </div>

      <div class="form-field">
        <label class="form-label" for="rsvp-wish">Ucapan &amp; Doa *</label>
        <textarea
          class="form-input form-textarea"
          id="rsvp-wish"
          name="wish"
          rows="3"
          required
          minlength="3"
          placeholder="Selamat pengantin baru & tahniah…"
          maxlength="300"
        ></textarea>
        <span class="form-error" id="rsvp-wish-error" role="alert" hidden></span>
      </div>

      <!-- General Submission Error Message -->
      <p class="form-submit-error" id="rsvp-submit-error" role="alert" hidden></p>

      <button class="form-submit-btn" id="rsvp-submit-btn" type="submit">
        <span id="rsvp-submit-label">Hantar RSVP</span>
        <span id="rsvp-submit-spinner" class="spinner" hidden aria-hidden="true"></span>
      </button>
    </form>
  </div>
</div>

<script>
  function setupRsvpModal() {
    const backdrop  = document.getElementById('rsvp-modal');
    const openBtn   = document.getElementById('open-rsvp-modal-btn');
    const closeBtn  = document.getElementById('close-rsvp-modal-btn');
    const form      = document.getElementById('rsvp-form') as HTMLFormElement | null;
    const success   = document.getElementById('rsvp-success');
    const submitBtn = document.getElementById('rsvp-submit-btn') as HTMLButtonElement | null;
    const submitLbl = document.getElementById('rsvp-submit-label');
    const submitSpn = document.getElementById('rsvp-submit-spinner');
    const submitErr = document.getElementById('rsvp-submit-error');

    if (!backdrop) return;

    const invitationId = backdrop.getAttribute('data-invitation-id') || 'mock-001';

    function openModal() {
      if (!backdrop) return;
      backdrop.hidden = false;
      document.body.style.overflow = 'hidden';
      const nameInput = document.getElementById('rsvp-name') as HTMLInputElement | null;
      if (nameInput) setTimeout(() => nameInput.focus(), 50);
    }

    function closeModal() {
      if (!backdrop) return;
      backdrop.hidden = true;
      document.body.style.overflow = '';
      openBtn?.focus();
    }

    openBtn?.addEventListener('click', openModal);
    closeBtn?.addEventListener('click', closeModal);

    // Close on backdrop click
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closeModal();
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop && !backdrop.hidden) {
        closeModal();
      }
    });

    function showError(id: string, msg: string) {
      const el = document.getElementById(id);
      if (el) {
        el.textContent = msg;
        el.hidden = false;
      }
    }

    function clearError(id: string) {
      const el = document.getElementById(id);
      if (el) {
        el.hidden = true;
        el.textContent = '';
      }
    }

    function validate(data: { guest_name?: string; telephone?: string; attendance_status?: string; wish?: string }): boolean {
      let valid = true;
      clearError('rsvp-name-error');
      clearError('rsvp-phone-error');
      clearError('rsvp-attend-error');
      clearError('rsvp-wish-error');
      if (submitErr) submitErr.hidden = true;

      if (!data.guest_name || data.guest_name.trim().length < 2) {
        showError('rsvp-name-error', 'Sila masukkan nama penuh anda (minimum 2 aksara).');
        valid = false;
      }
      if (!data.telephone || data.telephone.trim().length < 7) {
        showError('rsvp-phone-error', 'Sila masukkan nombor telefon yang sah.');
        valid = false;
      }
      if (!data.attendance_status) {
        showError('rsvp-attend-error', 'Sila pilih status kehadiran.');
        valid = false;
      }
      if (!data.wish || data.wish.trim().length < 3) {
        showError('rsvp-wish-error', 'Sila sertakan ucapan atau doa ringkas (minimum 3 aksara).');
        valid = false;
      }
      return valid;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form || !submitBtn || !submitLbl || !submitSpn || !submitErr) return;

      const fd = new FormData(form);
      const data = {
        invitation: invitationId,
        guest_name: String(fd.get('guest_name') ?? ''),
        telephone: String(fd.get('telephone') ?? ''),
        attendance_status: String(fd.get('attendance_status') ?? 'attending'),
        wish: String(fd.get('wish') ?? ''),
      };

      if (!validate(data)) return;

      submitLbl.hidden = true;
      submitSpn.hidden = false;
      submitBtn.disabled = true;
      submitErr.hidden = true;

      try {
        const res = await fetch('/api/rsvp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (!res.ok) {
          throw new Error(result.error || 'Gagal menghantar RSVP. Sila cuba sebentar lagi.');
        }

        // Transition to success state
        form.hidden = true;
        if (success) {
          success.hidden = false;
          try {
            const { animateRsvpSuccess } = await import('../../../lib/invitation-animations-songket');
            const origin = document.getElementById('sparkle-origin');
            if (origin) animateRsvpSuccess(origin);
          } catch {
            // Animation is progressive enhancement
          }
        }
      } catch (err: any) {
        submitErr.textContent = err.message || 'Ralat sambungan. Sila cuba lagi.';
        submitErr.hidden = false;
        submitLbl.hidden = false;
        submitSpn.hidden = true;
        submitBtn.disabled = false;
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRsvpModal);
  } else {
    setupRsvpModal();
  }
</script>

<style>
  /* Hidden attribute must always hide, even with display:flex set */
  [hidden] { display: none !important; }

  .rsvp-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(7, 29, 24, 0.9);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow-y: auto;
  }
  .rsvp-modal-backdrop:not([hidden]) {
    display: flex;
  }

  .modal-panel {
    position: relative;
    background: var(--deep-green);
    border: 1px solid rgba(217, 184, 103, 0.28);
    border-radius: 4px;
    padding: clamp(1.75rem, 5vw, 2.5rem);
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.6);
    animation: modal-in 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: translateY(20px) scale(0.98); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .modal-panel { animation: none; }
  }

  .modal-close {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    background: transparent;
    border: none;
    color: var(--muted);
    cursor: pointer;
    padding: 0.3rem;
    line-height: 0;
    border-radius: 2px;
    transition: color 0.2s ease, background 0.2s ease;
  }
  .modal-close:hover {
    color: var(--ivory);
    background: rgba(255, 255, 255, 0.05);
  }

  .modal-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .modal-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--antique-gold);
  }

  .modal-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.6rem, 5vw, 2.2rem);
    color: var(--ivory);
    font-weight: 600;
    margin: 0;
  }

  .modal-subheading {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0;
  }

  /* Success Message */
  .modal-success {
    text-align: center;
    padding: 2rem 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
  }

  .success-icon {
    font-size: 3.2rem;
    color: var(--antique-gold);
    position: relative;
    display: inline-block;
  }

  .success-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 2rem;
    color: var(--ivory);
    margin: 0;
  }

  .success-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.65;
    margin: 0;
    max-width: 36ch;
  }

  /* Form */
  .rsvp-form {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .form-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .form-input {
    padding: 0.75em 0.9em;
    background: rgba(7, 29, 24, 0.65);
    border: 1px solid rgba(184, 200, 190, 0.22);
    border-radius: 2px;
    color: var(--ivory);
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--antique-gold);
    box-shadow: 0 0 0 2px rgba(217, 184, 103, 0.2);
  }

  .form-textarea {
    resize: vertical;
    min-height: 84px;
  }

  /* Radio */
  .radio-group {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 0.25rem 0;
  }

  .radio-option {
    display: flex;
    align-items: center;
    gap: 0.55em;
    font-family: 'Inter', sans-serif;
    font-size: 0.88rem;
    color: var(--ivory);
    cursor: pointer;
  }

  .radio-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .radio-visual {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    border: 1.5px solid rgba(217, 184, 103, 0.5);
    flex-shrink: 0;
    transition: border-color 0.2s ease;
    position: relative;
  }

  .radio-visual::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--antique-gold);
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .radio-option input:checked ~ .radio-visual {
    border-color: var(--antique-gold);
  }

  .radio-option input:checked ~ .radio-visual::after {
    opacity: 1;
  }

  /* Validation errors */
  .form-error {
    font-family: 'Inter', sans-serif;
    font-size: 0.72rem;
    color: var(--rose);
  }

  .form-submit-error {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--rose);
    text-align: center;
    margin: 0;
    padding: 0.5rem;
    background: rgba(183, 123, 113, 0.12);
    border-radius: 2px;
  }

  /* Submit Button */
  .form-submit-btn {
    padding: 0.9em;
    background: var(--antique-gold);
    color: var(--midnight);
    border: none;
    border-radius: 2px;
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    transition: background 0.25s ease, transform 0.15s ease;
    margin-top: 0.35rem;
  }

  .form-submit-btn:hover {
    background: var(--light-gold);
  }

  .form-submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  /* Spinner */
  .spinner {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(7, 29, 24, 0.3);
    border-top-color: var(--midnight);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    display: inline-block;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .spinner {
      animation: none;
      border-top-color: transparent;
    }
  }

  /* Sparkles */
  :global(.sparkle-particle) {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--antique-gold);
    pointer-events: none;
  }
</style>
