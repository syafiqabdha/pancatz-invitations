---
/**
 * src/components/templates/songket/Cover.astro
 * Full-viewport welcome cover with traditional songket ornaments,
 * Bismillah, couple names, formatted date, and "Buka Undangan" CTA.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  inv: Invitation;
}

const { inv } = Astro.props;

const formattedDate = new Date(inv.event_date_time).toLocaleDateString('ms-MY', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: inv.timezone || 'Asia/Kuala_Lumpur',
});

const bismillah = inv.islamic_opening
  ? inv.islamic_opening.split('\n')[0]
  : 'بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ';
---

<section class="cover" id="cover" aria-label="Muka Depan Undangan">
  <!-- Corner ornaments from /ornaments/ -->
  <img
    src="/ornaments/corner.svg"
    alt=""
    aria-hidden="true"
    class="cover-corner corner-tl"
    width="160"
    height="160"
    loading="eager"
  />
  <img
    src="/ornaments/corner-flip.svg"
    alt=""
    aria-hidden="true"
    class="cover-corner corner-tr"
    width="160"
    height="160"
    loading="eager"
  />
  <img
    src="/ornaments/corner-flip.svg"
    alt=""
    aria-hidden="true"
    class="cover-corner corner-bl"
    width="160"
    height="160"
    loading="eager"
    style="transform: scale(1, -1);"
  />
  <img
    src="/ornaments/corner.svg"
    alt=""
    aria-hidden="true"
    class="cover-corner corner-br"
    width="160"
    height="160"
    loading="eager"
    style="transform: scale(-1, -1);"
  />

  <div class="cover-inner">
    <!-- Bismillah -->
    <p class="cover-bismillah" lang="ar" dir="rtl">
      {bismillah}
    </p>

    <!-- Couple names -->
    <h1 class="cover-names">
      <span class="cover-name">{inv.couple_name_1}</span>
      <span class="cover-amp">&amp;</span>
      <span class="cover-name">{inv.couple_name_2}</span>
    </h1>

    <!-- Event Date -->
    <p class="cover-date">{formattedDate}</p>

    <!-- Buka Undangan CTA Button -->
    <button
      class="cover-cta"
      id="buka-undangan-btn"
      type="button"
      aria-label="Buka Undangan Perkahwinan"
    >
      Buka Undangan
    </button>
  </div>
</section>

<style>
  .cover {
    position: fixed;
    inset: 0;
    z-index: 100;
    background-color: var(--midnight);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1.5rem;
  }

  /* Corner ornaments */
  .cover-corner {
    position: absolute;
    width: clamp(90px, 18vw, 160px);
    height: clamp(90px, 18vw, 160px);
    pointer-events: none;
    opacity: 0.85;
    filter: brightness(0) saturate(100%) invert(76%) sepia(43%) saturate(480%)
      hue-rotate(5deg) brightness(95%);
  }
  .corner-tl { top: 0; left: 0; }
  .corner-tr { top: 0; right: 0; transform: scaleX(-1); }
  .corner-bl { bottom: 0; left: 0; }
  .corner-br { bottom: 0; right: 0; }

  /* Inner container */
  .cover-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.35rem);
    text-align: center;
    max-width: 620px;
    width: 100%;
    position: relative;
    z-index: 2;
  }

  /* Bismillah */
  .cover-bismillah {
    font-family: 'Amiri', serif;
    font-size: clamp(1.4rem, 5vw, 2.2rem);
    color: var(--light-gold);
    line-height: 1.5;
    margin-bottom: 0.25rem;
  }

  /* Names */
  .cover-names {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.05em;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    color: var(--ivory);
    line-height: 0.95;
    margin: 0;
  }

  .cover-name {
    font-size: clamp(2.8rem, 13vw, 6.2rem);
    letter-spacing: -0.01em;
    display: block;
  }

  .cover-amp {
    font-size: clamp(1.2rem, 4vw, 2rem);
    color: var(--antique-gold);
    font-style: normal;
    display: block;
    margin: -0.1em 0;
  }

  /* Date */
  .cover-date {
    font-family: 'Inter', sans-serif;
    font-size: clamp(0.75rem, 2.4vw, 0.92rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.25rem;
  }

  /* CTA Button */
  .cover-cta {
    margin-top: clamp(0.75rem, 2.5vw, 1.25rem);
    padding: 0.85em 2.5em;
    background: transparent;
    border: 1.5px solid var(--antique-gold);
    color: var(--antique-gold);
    font-family: 'Inter', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
    animation: cta-pulse 2.5s ease-in-out infinite;
  }

  .cover-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--antique-gold);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .cover-cta:hover {
    color: var(--light-gold);
    border-color: var(--light-gold);
    transform: translateY(-1px);
  }

  .cover-cta:hover::before {
    opacity: 0.12;
  }

  .cover-cta:active {
    transform: translateY(0);
  }

  @keyframes cta-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(217, 184, 103, 0.4);
    }
    50% {
      box-shadow: 0 0 0 12px rgba(217, 184, 103, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cover-cta {
      animation: none;
    }
  }
</style>
