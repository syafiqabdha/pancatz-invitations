---
/**
 * src/components/templates/songket/Gallery.astro
 * 3-column photo gallery grid with 6 masonry-style placeholder items,
 * responsive 2-column layout on mobile, and gold border hover effects.
 */
import type { Invitation, Media } from '../../../lib/directus';

interface Props {
  inv: Invitation;
}

const { inv } = Astro.props;

const placeholders = [
  { bg: 'var(--jade)', aspect: 'tall' },
  { bg: 'var(--deep-green)', aspect: 'wide' },
  { bg: 'var(--midnight)', aspect: 'square' },
  { bg: 'var(--light-jade)', aspect: 'wide' },
  { bg: 'var(--jade)', aspect: 'square' },
  { bg: 'var(--deep-green)', aspect: 'tall' },
];

const gallery = (inv.gallery?.length ?? 0) > 0 ? inv.gallery! : null;
---

{inv.feature_flags?.gallery !== false && (
  <section class="gallery-section section-reveal" aria-label="Galeri Gambar">
    <div class="gallery-inner">
      <p class="gallery-label">Kenangan Indah</p>
      <h2 class="gallery-heading">Galeri Foto</h2>

      <div class="gallery-grid" role="list">
        {gallery
          ? gallery.slice(0, 6).map((item: Media) => (
              <div class="gallery-item" role="listitem">
                <img
                  src={`https://directus.pancatz.com/assets/${item.file.id}`}
                  alt={item.alt_text ?? 'Gambar kenangan majlis'}
                  class="gallery-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ))
          : placeholders.map((p, i) => (
              <div
                class={`gallery-item gallery-item--${p.aspect}`}
                style={`background: ${p.bg};`}
                role="listitem"
                aria-label={`Gambar kenangan ${i + 1}`}
              >
                <span class="gallery-placeholder-icon" aria-hidden="true">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.45">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </span>
              </div>
            ))
        }
      </div>
    </div>
  </section>
)}

<style>
  .gallery-section {
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem);
    background: var(--midnight);
  }

  .gallery-inner {
    max-width: 900px;
    margin: 0 auto;
  }

  .gallery-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--antique-gold);
    margin-bottom: 0.6rem;
  }

  .gallery-heading {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    color: var(--ivory);
    font-weight: 600;
    margin-bottom: clamp(1.5rem, 4vw, 2rem);
    line-height: 1.2;
  }

  /* Grid */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
  }

  @media (max-width: 540px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.65rem;
    }
  }

  .gallery-item {
    border-radius: 3px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    border: 1px solid rgba(217, 184, 103, 0.15);
  }

  .gallery-item:hover {
    transform: scale(1.025);
    border-color: var(--antique-gold);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--antique-gold);
    z-index: 2;
  }

  /* Aspect ratios */
  .gallery-item--tall   { aspect-ratio: 3 / 4; }
  .gallery-item--wide   { aspect-ratio: 4 / 3; }
  .gallery-item--square { aspect-ratio: 1 / 1; }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gallery-placeholder-icon {
    color: var(--ivory);
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
