---
/**
 * Footer.astro — Layout B Noir (Quiet Luxury)
 * Minimal centered footer: "Made by Pancatz" on dark background.
 */
---

<footer class="footer" role="contentinfo">
  <p class="footer__text">
    Made with love by
    <a
      href="https://pancatz.com"
      target="_blank"
      rel="noopener noreferrer"
      class="footer__link"
      aria-label="Layari laman web Pancatz"
    >Pancatz</a>
  </p>
</footer>

<style>
  .footer {
    background-color: #1A1A1A;
    border-top: 1px solid #2C2C2C;
    padding: 32px 20px;
    text-align: center;
  }

  .footer__text {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #666666;
    margin: 0;
  }

  .footer__link {
    color: #C5A55A;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer__link:hover,
  .footer__link:focus-visible {
    color: #D4B870;
    outline: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
</style>
