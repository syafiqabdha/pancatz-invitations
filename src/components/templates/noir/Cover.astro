---
/**
 * Cover.astro — Layout B Noir (Quiet Luxury)
 * Fullscreen cover with animated thin gold border, Bismillah, couple names, and "Open" CTA.
 * High-contrast cream (#FAF8F5) background with charcoal (#1A1A1A) text and champagne gold (#C5A55A) accents.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;
const bismillah = invitation.islamic_opening
  ? invitation.islamic_opening.split('\n')[0]
  : 'بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ';
---

<section
  id="cover"
  class="cover"
  role="dialog"
  aria-label="Jemputan Perkahwinan"
  aria-modal="true"
>
  <!-- Thin gold perimeter border SVG -->
  <svg class="cover__border" viewBox="0 0 800 1000" preserveAspectRatio="none" aria-hidden="true">
    <path
      id="cover-border-path"
      d="M24,24 L776,24 L776,976 L24,976 Z"
      fill="none"
      stroke="#C5A55A"
      stroke-width="1"
    />
    <!-- Corner brackets -->
    <path d="M24,24 L80,24 M24,24 L24,80" fill="none" stroke="#C5A55A" stroke-width="1.5" />
    <path d="M776,24 L720,24 M776,24 L776,80" fill="none" stroke="#C5A55A" stroke-width="1.5" />
    <path d="M24,976 L80,976 M24,976 L24,920" fill="none" stroke="#C5A55A" stroke-width="1.5" />
    <path d="M776,976 L720,976 M776,976 L776,920" fill="none" stroke="#C5A55A" stroke-width="1.5" />
  </svg>

  <div class="cover__content">
    <!-- Bismillah -->
    <p id="cover-bismillah" class="cover__bismillah" lang="ar" dir="rtl">
      {bismillah}
    </p>

    <span class="cover__subtitle">WALIMATULURUS</span>

    <!-- Couple names -->
    <div id="cover-names" class="cover__names">
      <span class="cover__name">{invitation.couple_name_1}</span>
      <span class="cover__ampersand">&amp;</span>
      <span class="cover__name">{invitation.couple_name_2}</span>
    </div>

    <!-- Open Invitation Button -->
    <button
      id="btn-open"
      class="cover__btn"
      type="button"
      aria-label="Buka jemputan perkahwinan"
    >
      Buka Undangan
    </button>
  </div>
</section>

<style>
  .cover {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #FAF8F5;
    color: #1A1A1A;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cover__border {
    position: absolute;
    inset: 16px;
    width: calc(100% - 32px);
    height: calc(100% - 32px);
    pointer-events: none;
  }

  .cover__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 3vh, 28px);
    text-align: center;
    padding: 32px 24px;
    z-index: 1;
    max-width: 600px;
    width: 100%;
  }

  .cover__bismillah {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(15px, 2.4vw, 20px);
    color: #8A8A8A;
    letter-spacing: 0.05em;
    margin: 0;
    line-height: 1.6;
  }

  .cover__subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8A8A8A;
  }

  .cover__names {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    line-height: 0.95;
  }

  .cover__name {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 100;
    font-size: clamp(52px, 13vw, 110px);
    color: #1A1A1A;
    letter-spacing: -0.02em;
    display: block;
  }

  .cover__ampersand {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 100;
    font-style: italic;
    font-size: clamp(24px, 5vw, 48px);
    color: #C5A55A;
    line-height: 1.2;
  }

  .cover__btn {
    margin-top: 12px;
    padding: 14px 38px;
    background: transparent;
    border: 1px solid #C5A55A;
    color: #1A1A1A;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .cover__btn:hover,
  .cover__btn:focus-visible {
    background: #C5A55A;
    color: #FAF8F5;
    outline: none;
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cover__btn {
      transition: none;
      transform: none;
    }
  }
</style>
