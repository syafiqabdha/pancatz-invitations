---
/**
 * RsvpSection.astro — Layout B Noir (Quiet Luxury)
 * Inline RSVP form at the bottom of the page (NOT a modal).
 * Fields: name, attendance, wish. Client-side validation + GSAP feedback.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;
---

<section class="rsvp" id="rsvp" aria-label="Pengesahan Kehadiran (RSVP)">
  <div class="rsvp__inner">
    <div class="rsvp__heading-block" data-reveal="up">
      <span class="rsvp__label">RSVP</span>
      <h2 class="rsvp__title">Pengesahan Kehadiran</h2>
      <p class="rsvp__subtitle">Sila maklumkan kehadiran anda agar memudahkan persiapan majlis kami.</p>
    </div>

    <!-- Inline Form -->
    <form
      id="rsvp-form"
      class="rsvp__form"
      novalidate
      data-invitation-id={invitation.id}
      data-reveal="up"
    >
      <!-- Name -->
      <div class="rsvp__field" id="rsvp-field-name">
        <label class="rsvp__field-label" for="rsvp-name">Nama Anda</label>
        <input
          type="text"
          id="rsvp-name"
          name="guest_name"
          class="rsvp__input"
          placeholder="Nama penuh anda"
          autocomplete="name"
          required
          minlength="2"
          aria-required="true"
          aria-describedby="rsvp-name-err"
        />
        <span class="rsvp__error" id="rsvp-name-err" role="alert" aria-live="polite"></span>
      </div>

      <!-- Attendance -->
      <fieldset class="rsvp__fieldset" id="rsvp-field-attendance">
        <legend class="rsvp__field-label">Status Kehadiran</legend>
        <div class="rsvp__radio-group">
          <label class="rsvp__radio-label">
            <input
              type="radio"
              name="attendance_status"
              value="attending"
              class="rsvp__radio"
              required
            />
            <span class="rsvp__radio-custom" aria-hidden="true"></span>
            Hadir
          </label>
          <label class="rsvp__radio-label">
            <input
              type="radio"
              name="attendance_status"
              value="not_attending"
              class="rsvp__radio"
            />
            <span class="rsvp__radio-custom" aria-hidden="true"></span>
            Tidak dapat hadir
          </label>
        </div>
        <span class="rsvp__error" id="rsvp-attendance-err" role="alert" aria-live="polite"></span>
      </fieldset>

      <!-- Wish -->
      <div class="rsvp__field" id="rsvp-field-wish">
        <label class="rsvp__field-label" for="rsvp-wish">Ucapan &amp; Doa (Pilihan)</label>
        <textarea
          id="rsvp-wish"
          name="wish"
          class="rsvp__textarea"
          placeholder="Tuliskan ucapan dan doa tulus anda di sini…"
          rows="4"
          maxlength="500"
          aria-describedby="rsvp-wish-count"
        ></textarea>
        <span class="rsvp__char-count" id="rsvp-wish-count" aria-live="polite">0 / 500</span>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="rsvp__submit" id="rsvp-submit-btn">
        <span id="rsvp-submit-text">Hantar Pengesahan</span>
        <svg class="rsvp__submit-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </form>

    <!-- Success Message Card -->
    <div id="rsvp-success" class="rsvp__success" style="display:none;" aria-live="assertive">
      <svg class="rsvp__success-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <circle cx="24" cy="24" r="22" stroke="#C5A55A" stroke-width="1.5"/>
        <path d="M14 24l7 7 13-13" stroke="#C5A55A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <p class="rsvp__success-text">Terima kasih! Maklum balas dan ucapan anda telah selamat diterima.</p>
    </div>
  </div>
</section>

<style>
  .rsvp {
    background-color: #1A1A1A;
    color: #FAF8F5;
    padding: clamp(64px, 12vw, 120px) clamp(20px, 5vw, 80px);
  }

  .rsvp__inner {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* ── Heading ── */
  .rsvp__label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #C5A55A;
    margin-bottom: 12px;
  }

  .rsvp__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 100;
    font-size: clamp(28px, 5vw, 44px);
    color: #FAF8F5;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .rsvp__subtitle {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #8A8A8A;
    margin: 0;
    line-height: 1.6;
  }

  /* ── Form ── */
  .rsvp__form {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .rsvp__field,
  .rsvp__fieldset {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: none;
    padding: 0;
    margin: 0;
  }

  .rsvp__field-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8A8A8A;
  }

  .rsvp__input,
  .rsvp__textarea {
    background: transparent;
    border: none;
    border-bottom: 1px solid #3A3A3A;
    color: #FAF8F5;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    padding: 12px 0;
    width: 100%;
    outline: none;
    transition: border-color 0.25s ease;
    resize: none;
  }

  .rsvp__input::placeholder,
  .rsvp__textarea::placeholder {
    color: #4A4A4A;
  }

  .rsvp__input:focus,
  .rsvp__textarea:focus {
    border-bottom-color: #C5A55A;
  }

  /* ── Radio Buttons ── */
  .rsvp__radio-group {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    padding-top: 4px;
  }

  .rsvp__radio-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    color: #FAF8F5;
    cursor: pointer;
  }

  .rsvp__radio {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .rsvp__radio-custom {
    width: 18px;
    height: 18px;
    border: 1px solid #4A4A4A;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .rsvp__radio:checked + .rsvp__radio-custom {
    border-color: #C5A55A;
    background-color: #C5A55A;
    box-shadow: inset 0 0 0 3px #1A1A1A;
  }

  .rsvp__radio:focus-visible + .rsvp__radio-custom {
    outline: 2px solid #C5A55A;
    outline-offset: 2px;
  }

  /* ── Char Count ── */
  .rsvp__char-count {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    color: #4A4A4A;
    text-align: right;
  }

  /* ── Error Messages ── */
  .rsvp__error {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #E8C4B8;
    min-height: 1.2em;
  }

  /* ── Submit Button ── */
  .rsvp__submit {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background-color: #C5A55A;
    color: #1A1A1A;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    align-self: flex-start;
    transition: background-color 0.25s ease, opacity 0.25s ease;
  }

  .rsvp__submit:hover:not(:disabled),
  .rsvp__submit:focus-visible:not(:disabled) {
    background-color: #B8943F;
    outline: none;
  }

  .rsvp__submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .rsvp__submit-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Success State ── */
  .rsvp__success {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 48px 0;
  }

  .rsvp__success-icon {
    width: 64px;
    height: 64px;
  }

  .rsvp__success-text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(16px, 2.5vw, 20px);
    color: #FAF8F5;
    margin: 0;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .rsvp__input,
    .rsvp__textarea,
    .rsvp__submit,
    .rsvp__radio-custom {
      transition: none;
    }
  }
</style>

<script>
  import { animateFieldError, animateRsvpSuccess } from '../../../lib/invitation-animations-noir';

  const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('rsvp-submit-btn') as HTMLButtonElement | null;
  const submitText = document.getElementById('rsvp-submit-text');
  const wishTextarea = document.getElementById('rsvp-wish') as HTMLTextAreaElement | null;
  const charCount = document.getElementById('rsvp-wish-count');

  // Character counter
  wishTextarea?.addEventListener('input', () => {
    const len = wishTextarea.value.length;
    if (charCount) charCount.textContent = `${len} / 500`;
  });

  function setError(fieldId: string, errId: string, msg: string): void {
    const field = document.getElementById(fieldId);
    const errEl = document.getElementById(errId);
    if (errEl) errEl.textContent = msg;
    if (field) {
      animateFieldError(`#${fieldId}`);
    }
  }

  function clearError(errId: string): void {
    const errEl = document.getElementById(errId);
    if (errEl) errEl.textContent = '';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const data = new FormData(form);
    const guestName = (data.get('guest_name') as string ?? '').trim();
    const attendance = data.get('attendance_status') as string ?? '';
    const wish = (data.get('wish') as string ?? '').trim();
    const invitationId = form.dataset['invitationId'] ?? '';

    let valid = true;

    if (guestName.length < 2) {
      setError('rsvp-field-name', 'rsvp-name-err', 'Sila masukkan nama anda.');
      valid = false;
    } else {
      clearError('rsvp-name-err');
    }

    if (!attendance) {
      setError('rsvp-field-attendance', 'rsvp-attendance-err', 'Sila pilih status kehadiran anda.');
      valid = false;
    } else {
      clearError('rsvp-attendance-err');
    }

    if (!valid) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      if (submitText) submitText.textContent = 'Menghantar…';
    }

    try {
      const res = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          invitation: invitationId,
          guest_name: guestName,
          telephone: '',
          wish,
          attendance_status: attendance,
        }),
      });

      if (res.ok) {
        animateRsvpSuccess('#rsvp-form', '#rsvp-success');
      } else {
        if (submitBtn) submitBtn.disabled = false;
        if (submitText) submitText.textContent = 'Hantar Pengesahan';
        const errEl = document.getElementById('rsvp-name-err');
        if (errEl) errEl.textContent = 'Ralat berlaku. Sila cuba lagi sebentar.';
      }
    } catch {
      if (submitBtn) submitBtn.disabled = false;
      if (submitText) submitText.textContent = 'Hantar Pengesahan';
      const errEl = document.getElementById('rsvp-name-err');
      if (errEl) errEl.textContent = 'Ralat sambungan. Sila cuba lagi.';
    }
  });
</script>
