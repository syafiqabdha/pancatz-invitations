---
/**
 * GiftSection.astro — Layout B Noir (Quiet Luxury)
 * Compact expandable card using <details>/<summary> with copy-to-clipboard.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;

const giftNote = invitation.gift_details ||
  'Kehadiran dan doa restu anda adalah hadiah yang paling bermakna buat kami. Namun jika ingin memberi ingatan tulus, anda boleh menggunakan DuitNow di bawah.';
const accountNumber = '0123456789';
const accountName = `${invitation.couple_name_1} & ${invitation.couple_name_2}`;
---

<section class="gift" aria-label="Maklumat Hadiah & Salam Kaut" data-reveal="up">
  <details class="gift__details" id="gift-details">
    <summary class="gift__summary">
      <span class="gift__summary-label">Hadiah &amp; Salam Kaut</span>
      <span class="gift__summary-hint">Klik untuk lihat maklumat</span>
      <svg class="gift__chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </summary>

    <div class="gift__body">
      <p class="gift__note">{giftNote}</p>

      <!-- DuitNow Account Card -->
      <div class="gift__account-row">
        <div class="gift__account-info">
          <span class="gift__account-label">DuitNow / Akaun</span>
          <span class="gift__account-value" id="gift-account-number">{accountNumber}</span>
          <span class="gift__account-holder">{accountName}</span>
        </div>
        <button
          type="button"
          class="gift__copy-btn"
          id="gift-copy-btn"
          data-copy={accountNumber}
          aria-label="Salin nombor akaun ke papan keratan"
        >
          <svg class="gift__copy-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.5"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span id="gift-copy-text">Salin</span>
        </button>
      </div>
    </div>
  </details>
</section>

<style>
  .gift {
    padding: 0 clamp(20px, 5vw, 80px) clamp(48px, 8vw, 96px);
  }

  .gift__details {
    background-color: #F5F0E8;
    box-shadow: 0 4px 32px rgba(44, 44, 44, 0.08);
    max-width: 600px;
    margin: 0 auto;
    overflow: hidden;
    border-top: 2px solid #C5A55A;
  }

  .gift__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 24px 28px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: background-color 0.2s ease;
  }

  .gift__summary::-webkit-details-marker {
    display: none;
  }

  .gift__summary:hover {
    background-color: #EDE7DD;
  }

  .gift__summary-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #1A1A1A;
    flex-shrink: 0;
  }

  .gift__summary-hint {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    color: #8A8A8A;
    flex: 1;
    text-align: right;
  }

  .gift__chevron {
    width: 18px;
    height: 18px;
    color: #8A8A8A;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }

  .gift__details[open] .gift__chevron {
    transform: rotate(180deg);
  }

  .gift__body {
    padding: 0 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .gift__note {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #8A8A8A;
    line-height: 1.65;
    margin: 0;
  }

  .gift__account-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 20px;
    background-color: #FAF8F5;
    border: 1px solid #E8E0D4;
  }

  .gift__account-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .gift__account-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8A8A8A;
  }

  .gift__account-value {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    color: #1A1A1A;
    letter-spacing: 0.05em;
  }

  .gift__account-holder {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    color: #8A8A8A;
  }

  .gift__copy-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    background-color: #1A1A1A;
    color: #FAF8F5;
    border: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
    flex-shrink: 0;
  }

  .gift__copy-btn:hover,
  .gift__copy-btn:focus-visible {
    background-color: #2C2C2C;
    outline: none;
  }

  .gift__copy-btn.copied {
    background-color: #A8B5A0;
  }

  .gift__copy-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gift__chevron,
    .gift__copy-btn,
    .gift__summary {
      transition: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('gift-copy-btn') as HTMLButtonElement | null;
  const copyText = document.getElementById('gift-copy-text');

  btn?.addEventListener('click', async () => {
    const value = btn.dataset['copy'] ?? '';
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(value);
      } else {
        const input = document.createElement('textarea');
        input.value = value;
        input.setAttribute('readonly', '');
        input.style.position = 'fixed';
        input.style.opacity = '0';
        document.body.appendChild(input);
        input.select();
        input.setSelectionRange(0, 99999);
        navigator.clipboard?.writeText(value);
        document.body.removeChild(input);
      }
      btn.classList.add('copied');
      if (copyText) copyText.textContent = 'Disalin!';
      setTimeout(() => {
        btn.classList.remove('copied');
        if (copyText) copyText.textContent = 'Salin';
      }, 2000);
    } catch {
      // Ignore copy error
    }
  });
</script>
