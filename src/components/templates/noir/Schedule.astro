---
/**
 * Schedule.astro — Layout B Noir (Quiet Luxury)
 * Horizontal card timeline (desktop: scrollable row, mobile: vertical stack).
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;

type ScheduleItem = { time: string; description: string };
const defaultSchedule: ScheduleItem[] = [
  { time: '11:00 Pagi', description: 'Ketibaan Tetamu' },
  { time: '12:30 Tengahari', description: 'Ketibaan Pengantin' },
  { time: '1:00 Petang', description: 'Majlis Bersanding' },
  { time: '2:00 Petang', description: 'Jamuan Makan' },
  { time: '4:00 Petang', description: 'Bersurai' },
];

const schedule: ScheduleItem[] = (invitation.schedule && invitation.schedule.length > 0)
  ? invitation.schedule
  : defaultSchedule;
---

<section class="schedule" aria-label="Aturcara Majlis" data-reveal="up">
  <div class="schedule__header">
    <span class="schedule__label">Aturcara</span>
    <div class="schedule__divider" aria-hidden="true"></div>
  </div>

  <!-- Horizontal scroll track -->
  <div class="schedule__track-wrap" role="list" aria-label="Senarai aturcara">
    <div id="schedule-track" class="schedule__track">
      {schedule.map((item, idx) => (
        <article class="schedule-card" role="listitem">
          <span class="schedule-card__index" aria-hidden="true">
            {String(idx + 1).padStart(2, '0')}
          </span>
          <time class="schedule-card__time">{item.time}</time>
          <div class="schedule-card__divider" aria-hidden="true"></div>
          <p class="schedule-card__desc">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .schedule {
    padding: clamp(48px, 8vw, 96px) 0;
    overflow: hidden;
  }

  .schedule__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(20px, 5vw, 80px);
    margin-bottom: 36px;
  }

  .schedule__label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8A8A8A;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .schedule__divider {
    flex: 1;
    height: 1px;
    background: #E8E0D4;
  }

  /* ── Horizontal Scroll Track ── */
  .schedule__track-wrap {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #E8E0D4 transparent;
    -webkit-overflow-scrolling: touch;
    padding: 0 clamp(20px, 5vw, 80px) 16px;
  }

  .schedule__track-wrap::-webkit-scrollbar {
    height: 4px;
  }

  .schedule__track-wrap::-webkit-scrollbar-track {
    background: transparent;
  }

  .schedule__track-wrap::-webkit-scrollbar-thumb {
    background: #E8E0D4;
    border-radius: 2px;
  }

  .schedule__track {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  /* ── Schedule Card ── */
  .schedule-card {
    background-color: #F5F0E8;
    box-shadow: 0 2px 16px rgba(44, 44, 44, 0.07);
    padding: 32px 24px;
    width: 200px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .schedule-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 28px rgba(44, 44, 44, 0.12);
  }

  .schedule-card__index {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 100;
    font-size: 36px;
    color: #E8E0D4;
    line-height: 1;
    position: absolute;
    top: 16px;
    right: 16px;
    pointer-events: none;
  }

  .schedule-card__time {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: 15px;
    color: #C5A55A;
    letter-spacing: 0.04em;
  }

  .schedule-card__divider {
    height: 1px;
    background-color: #E8E0D4;
    width: 32px;
  }

  .schedule-card__desc {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #2C2C2C;
    line-height: 1.5;
    margin: 0;
  }

  /* ── Mobile: Vertical Stack ── */
  @media (max-width: 640px) {
    .schedule__track-wrap {
      overflow-x: visible;
      padding-bottom: 0;
    }

    .schedule__track {
      flex-direction: column;
      width: 100%;
    }

    .schedule-card {
      width: 100%;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 20px 20px;
    }

    .schedule-card__index {
      position: static;
      font-size: 22px;
      flex-shrink: 0;
      color: #C5A55A;
    }

    .schedule-card__divider {
      display: none;
    }

    .schedule-card__desc {
      text-align: right;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .schedule-card {
      transition: none;
    }
    .schedule-card:hover {
      transform: none;
    }
  }
</style>
