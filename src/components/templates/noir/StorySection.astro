---
/**
 * StorySection.astro — Layout B Noir (Quiet Luxury)
 * Floating offset card with couple story in Playfair italic and a minimal gold divider.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;
const storyText = invitation.story ||
  'Kami bertemu di universiti, berkawan selama tiga tahun, dan menyedari bahawa kami tidak mahu melalui hidup tanpa satu sama lain. Selepas lima tahun bersama, di sini kami berdiri — bersedia untuk memulakan perjalanan terbesar dalam hidup kami.';
---

<section class="story" aria-label="Kisah Kami" data-reveal="right">
  <div class="story__card">
    <div class="story__header">
      <span class="story__label">Kisah Kami</span>
      <div class="story__gold-divider" aria-hidden="true"></div>
    </div>
    <blockquote class="story__text">
      {storyText}
    </blockquote>
  </div>
</section>

<style>
  .story {
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 80px);
    display: flex;
    justify-content: flex-end;
  }

  .story__card {
    background-color: #F5F0E8;
    box-shadow: 0 4px 32px rgba(44, 44, 44, 0.08), 0 1px 4px rgba(44, 44, 44, 0.04);
    padding: clamp(36px, 5vw, 64px);
    max-width: 600px;
    width: 100%;
    position: relative;
  }

  /* Subtle gold corner framing */
  .story__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 40px;
    height: 40px;
    border-top: 1px solid #C5A55A;
    border-left: 1px solid #C5A55A;
    pointer-events: none;
  }

  .story__header {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .story__label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8A8A8A;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .story__gold-divider {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, #C5A55A 0%, transparent 100%);
  }

  .story__text {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(16px, 2.2vw, 20px);
    color: #2C2C2C;
    line-height: 1.8;
    margin: 0;
  }

  @media (max-width: 768px) {
    .story {
      justify-content: center;
    }

    .story__card {
      max-width: 100%;
    }
  }
</style>
