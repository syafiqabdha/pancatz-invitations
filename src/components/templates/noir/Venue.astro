---
/**
 * Venue.astro — Layout B Noir (Quiet Luxury)
 * Full-width venue details card with Google Maps and Waze navigation buttons.
 */
import type { Invitation } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;

const venueName = invitation.venue_name || 'Dewan Seri Melati';
const venueAddress = invitation.venue_address || 'Jalan Merdeka 45, 50450 Kuala Lumpur';
const googleMapsUrl = invitation.google_maps_url || `https://maps.google.com/?q=${encodeURIComponent(venueName + ' ' + venueAddress)}`;
const wazeUrl = invitation.waze_url || `https://waze.com/ul?q=${encodeURIComponent(venueName + ' ' + venueAddress)}`;
---

<section class="venue" aria-label="Lokasi Majlis" data-reveal="up">
  <div class="venue__card">
    <!-- Decorative vertical gold strip -->
    <div class="venue__strip" aria-hidden="true"></div>

    <div class="venue__inner">
      <div class="venue__text">
        <span class="venue__label">Lokasi Majlis</span>
        <h2 class="venue__name">{venueName}</h2>
        {venueAddress && <p class="venue__address">{venueAddress}</p>}
      </div>

      <div class="venue__actions">
        {googleMapsUrl && (
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="venue__btn venue__btn--maps"
            aria-label={`Buka ${venueName} di Google Maps`}
          >
            <svg class="venue__btn-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
            </svg>
            Google Maps
          </a>
        )}

        {wazeUrl && (
          <a
            href={wazeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="venue__btn venue__btn--waze"
            aria-label={`Buka ${venueName} di Waze`}
          >
            <svg class="venue__btn-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="9" cy="14" r="1" fill="currentColor"/>
              <circle cx="15" cy="14" r="1" fill="currentColor"/>
              <path d="M9 11.5c.83.67 1.67 1 3 1s2.17-.33 3-1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
            Waze
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .venue {
    padding: clamp(48px, 8vw, 96px) clamp(20px, 5vw, 80px);
  }

  .venue__card {
    background-color: #F5F0E8;
    box-shadow: 0 4px 32px rgba(44, 44, 44, 0.08), 0 1px 4px rgba(44, 44, 44, 0.04);
    display: flex;
    overflow: hidden;
    position: relative;
    max-width: 960px;
    margin: 0 auto;
  }

  .venue__strip {
    width: 4px;
    background-color: #C5A55A;
    flex-shrink: 0;
  }

  .venue__inner {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: clamp(32px, 5vw, 52px);
    flex-wrap: wrap;
  }

  .venue__text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 520px;
  }

  .venue__label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #8A8A8A;
  }

  .venue__name {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: clamp(24px, 4vw, 36px);
    color: #1A1A1A;
    line-height: 1.2;
    margin: 0;
  }

  .venue__address {
    font-family: 'DM Sans', sans-serif;
    font-size: 14px;
    color: #8A8A8A;
    line-height: 1.6;
    margin: 4px 0 0;
  }

  .venue__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .venue__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 22px;
    border: 1px solid #2C2C2C;
    color: #1A1A1A;
    background: transparent;
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .venue__btn:hover,
  .venue__btn:focus-visible {
    background-color: #1A1A1A;
    color: #FAF8F5;
    outline: none;
  }

  .venue__btn-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  @media (max-width: 680px) {
    .venue__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .venue__actions {
      width: 100%;
    }

    .venue__btn {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .venue__btn {
      transition: none;
    }
  }
</style>
