---
/**
 * Gallery.astro — Layout B Noir (Quiet Luxury)
 * Horizontal scroll photo essay on desktop, 2-column grid on mobile.
 */
import type { Invitation, Media } from '../../../lib/directus';

interface Props {
  invitation: Invitation;
}

const { invitation } = Astro.props;

const mediaPhotos: Media[] = (invitation.gallery ?? []).filter((m: Media) => m.type === 'photo');
const DIRECTUS_URL = import.meta.env.DIRECTUS_URL ?? '';

// Curated Quiet Luxury placeholder palette
const placeholderColors = [
  '#E8E0D4', '#A8B5A0', '#E8C4B8', '#C5A55A',
  '#D4C4B4', '#8A8A8A', '#F5F0E8', '#2C2C2C',
];

const hasRealPhotos = mediaPhotos.length > 0;
const itemCount = hasRealPhotos ? mediaPhotos.length : 8;
---

<section class="gallery" aria-label="Galeri Foto" data-reveal="up">
  <div class="gallery__header">
    <span class="gallery__label">Galeri</span>
    <div class="gallery__divider" aria-hidden="true"></div>
  </div>

  <!-- Gallery track: horizontal scroll on desktop, 2-column grid on mobile -->
  <div class="gallery__scroll-wrap" role="list" aria-label="Galeri gambar perkahwinan">
    <div class="gallery__track">
      {Array.from({ length: itemCount }, (_, i) => (
        <figure class="gallery__item" role="listitem">
          {hasRealPhotos && mediaPhotos[i] ? (
            <img
              src={`${DIRECTUS_URL}/assets/${mediaPhotos[i]!.file.id}`}
              alt={mediaPhotos[i]!.alt_text ?? `Gambar kenangan ${i + 1}`}
              class="gallery__img"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div
              class="gallery__placeholder"
              style={`background-color: ${placeholderColors[i % placeholderColors.length]};`}
              aria-label={`Foto placeholder ${i + 1}`}
            ></div>
          )}
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery {
    padding: clamp(48px, 8vw, 96px) 0;
    overflow: hidden;
  }

  .gallery__header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 clamp(20px, 5vw, 80px);
    margin-bottom: 36px;
  }

  .gallery__label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8A8A8A;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .gallery__divider {
    flex: 1;
    height: 1px;
    background-color: #E8E0D4;
  }

  /* ── Desktop: Horizontal Scroll ── */
  .gallery__scroll-wrap {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: #E8E0D4 transparent;
    -webkit-overflow-scrolling: touch;
    padding: 0 clamp(20px, 5vw, 80px) 16px;
  }

  .gallery__scroll-wrap::-webkit-scrollbar {
    height: 4px;
  }

  .gallery__scroll-wrap::-webkit-scrollbar-thumb {
    background: #E8E0D4;
    border-radius: 2px;
  }

  .gallery__track {
    display: flex;
    gap: 16px;
    width: max-content;
  }

  .gallery__item {
    margin: 0;
    flex-shrink: 0;
    overflow: hidden;
  }

  /* Editorial staggered heights */
  .gallery__item:nth-child(odd) {
    height: 320px;
    width: 220px;
  }

  .gallery__item:nth-child(even) {
    height: 260px;
    width: 200px;
    margin-top: 36px;
  }

  .gallery__img,
  .gallery__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery__item:hover .gallery__img,
  .gallery__item:hover .gallery__placeholder {
    transform: scale(1.03);
  }

  /* ── Mobile: 2-Column Grid ── */
  @media (max-width: 640px) {
    .gallery__scroll-wrap {
      overflow-x: visible;
      padding: 0 clamp(20px, 5vw, 80px);
    }

    .gallery__track {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      width: 100%;
    }

    .gallery__item {
      height: 190px !important;
      width: 100% !important;
      margin-top: 0 !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__img,
    .gallery__placeholder {
      transition: none;
    }
    .gallery__item:hover .gallery__img,
    .gallery__item:hover .gallery__placeholder {
      transform: none;
    }
  }
</style>
