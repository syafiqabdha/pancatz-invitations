---
/**
 * Hero.astro — Full-screen hero panel with wreath countdown (Layout C: Ethereal Garden)
 */
export interface Props {
  coupleName1: string;
  coupleName2: string;
  eventDateIso: string;
  calendarUrl: string;
}

const { coupleName1, coupleName2, eventDateIso, calendarUrl } = Astro.props;
---

<section class="garden-panel garden-hero" id="hero" aria-label="Maklumat Utama" data-event-date={eventDateIso}>
  <!-- Garland top decoration -->
  <img class="garden-hero__garland" src="/botanicals/garland-top.svg" alt="" aria-hidden="true" />

  <div class="garden-hero__inner">
    <div class="garden-hero__tag">
      <span class="garden-hero__tag-text">MENYATUKAN DUA JIWA</span>
    </div>

    <div class="garden-hero__couple">
      <span class="garden-hero__name">{coupleName1}</span>
      <span class="garden-hero__connector">&amp;</span>
      <span class="garden-hero__name">{coupleName2}</span>
    </div>

    <!-- Floral wreath countdown -->
    <div class="garden-hero__wreath-wrap" aria-label="Kiraan Detik Perkahwinan">
      <img class="garden-hero__wreath-img" src="/botanicals/wreath.svg" alt="" aria-hidden="true" />
      <div class="garden-hero__countdown" aria-live="polite">
        <div class="cd-unit">
          <span class="cd-days cd-num">00</span>
          <span class="cd-label">Hari</span>
        </div>
        <span class="cd-colon" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-hours cd-num">00</span>
          <span class="cd-label">Jam</span>
        </div>
        <span class="cd-colon" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-mins cd-num">00</span>
          <span class="cd-label">Min</span>
        </div>
        <span class="cd-colon" aria-hidden="true">:</span>
        <div class="cd-unit">
          <span class="cd-secs cd-num">00</span>
          <span class="cd-label">Saat</span>
        </div>
      </div>
    </div>

    <!-- Save to Calendar Button -->
    <a class="garden-hero__cal-btn" href={calendarUrl} target="_blank" rel="noopener" aria-label="Simpan Tarikh Majlis ke Kalendar">
      <svg class="garden-hero__cal-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>Simpan ke Kalendar</span>
    </a>
  </div>
</section>

<style>
  .garden-hero {
    background: linear-gradient(170deg, #FDF8F0 0%, #F5ECD7 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    height: 100dvh;
    min-height: 100dvh;
    box-sizing: border-box;
  }

  .garden-hero__garland {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(260px, 65vw, 480px);
    opacity: 0.55;
    pointer-events: none;
    z-index: 1;
  }

  .garden-hero__inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2vh, 1.4rem);
    max-width: 480px;
    width: 100%;
  }

  .garden-hero__tag {
    display: inline-block;
  }

  .garden-hero__tag-text {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(0.68rem, 1.6vw, 0.78rem);
    letter-spacing: 0.22em;
    color: #8FA98A;
    text-transform: uppercase;
    font-weight: 500;
  }

  .garden-hero__couple {
    display: flex;
    align-items: center;
    gap: 0.4em;
    flex-wrap: wrap;
    justify-content: center;
  }

  .garden-hero__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.8rem, 5.5vw, 2.8rem);
    color: #3D3D3D;
    letter-spacing: 0.02em;
  }

  .garden-hero__connector {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.4rem, 4vw, 2rem);
    color: #C4988A;
    font-weight: 400;
  }

  /* Wreath + countdown overlay */
  .garden-hero__wreath-wrap {
    position: relative;
    width: clamp(180px, 46vw, 250px);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .garden-hero__wreath-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    animation: garden-wreath-spin 60s linear infinite;
    pointer-events: none;
  }

  @keyframes garden-wreath-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garden-hero__wreath-img {
      animation: none;
    }
  }

  .garden-hero__countdown {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.3rem, 1.2vw, 0.6rem);
    background: rgba(253, 248, 240, 0.88);
    backdrop-filter: blur(4px);
    padding: 0.5rem 0.8rem;
    border-radius: 999px;
    border: 1px solid rgba(143, 169, 138, 0.25);
    box-shadow: 0 4px 14px rgba(92, 122, 84, 0.08);
  }

  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1em;
    min-width: 2.2ch;
  }

  .cd-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 700;
    font-size: clamp(1.15rem, 3.5vw, 1.6rem);
    color: #3D3D3D;
    line-height: 1;
    text-align: center;
  }

  .cd-label {
    font-family: 'Lora', Georgia, serif;
    font-size: 0.55rem;
    color: #5C7A54;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .cd-colon {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.1rem;
    color: #8FA98A;
    margin-top: -0.35em;
  }

  .garden-hero__cal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.7em 1.8em;
    border: 1.5px solid #5C7A54;
    border-radius: 999px;
    background: #FDF8F0;
    color: #5C7A54;
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(0.82rem, 1.8vw, 0.92rem);
    text-decoration: none;
    letter-spacing: 0.06em;
    box-shadow: 0 3px 12px rgba(92, 122, 84, 0.1);
    transition: background 0.25s, color 0.25s, transform 0.2s, box-shadow 0.2s;
  }

  .garden-hero__cal-btn:hover,
  .garden-hero__cal-btn:focus-visible {
    background: #5C7A54;
    color: #FDF8F0;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(92, 122, 84, 0.2);
    outline: none;
  }
</style>
