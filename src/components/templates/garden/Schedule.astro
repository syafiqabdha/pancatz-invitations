---
/**
 * Schedule.astro — Full-screen vertical timeline with flower markers (Layout C: Ethereal Garden)
 */
export interface Props {
  schedule?: { time: string; description: string }[];
}

const { schedule } = Astro.props;
if (!schedule?.length) return;
---

<section class="garden-panel garden-sched" id="schedule" aria-label="Aturcara Majlis">
  <img class="garden-sched__garland" src="/botanicals/garland-top.svg" alt="" aria-hidden="true" />

  <div class="garden-sched__inner">
    <div class="garden-sched__header">
      <h2 class="garden-sched__title">Aturcara Majlis</h2>
      <img class="garden-sched__sprig" src="/botanicals/divider-sprig.svg" alt="" aria-hidden="true" />
    </div>

    <ol class="garden-sched__list" role="list">
      {schedule.map((item, i) => (
        <li class="garden-sched__item" style={`--delay: ${i * 0.08}s`}>
          <!-- Flower marker SVG -->
          <div class="garden-sched__flower" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" width="24" height="24">
              <circle cx="16" cy="16" r="3.5" fill="#D4A843"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#E8C4B8" transform="rotate(0 16 16)" transform-origin="16 16"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#C4988A" opacity="0.75" transform="rotate(60 16 16)" transform-origin="16 16"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#E8C4B8" transform="rotate(120 16 16)" transform-origin="16 16"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#C4988A" opacity="0.75" transform="rotate(180 16 16)" transform-origin="16 16"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#E8C4B8" transform="rotate(240 16 16)" transform-origin="16 16"/>
              <ellipse cx="16" cy="8" rx="3" ry="5.5" fill="#C4988A" opacity="0.75" transform="rotate(300 16 16)" transform-origin="16 16"/>
            </svg>
          </div>
          <!-- Content -->
          <div class="garden-sched__content">
            <time class="garden-sched__time">{item.time}</time>
            <p class="garden-sched__desc">{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .garden-sched {
    background: linear-gradient(160deg, #F5ECD7 0%, #FDF8F0 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    height: 100dvh;
    min-height: 100dvh;
    box-sizing: border-box;
  }

  .garden-sched__garland {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%) scaleY(-1);
    width: clamp(200px, 50vw, 380px);
    opacity: 0.35;
    pointer-events: none;
    z-index: 1;
  }

  .garden-sched__inner {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
    width: 100%;
    max-width: 440px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.75rem, 2vh, 1.4rem);
  }

  .garden-sched__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .garden-sched__title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.5rem, 3.8vw, 2.1rem);
    color: #5C7A54;
    margin: 0;
    font-weight: 600;
  }

  .garden-sched__sprig {
    width: clamp(60px, 14vw, 100px);
    opacity: 0.55;
  }

  .garden-sched__list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
  }

  /* Vertical connecting line */
  .garden-sched__list::before {
    content: '';
    position: absolute;
    left: 11px;
    top: 12px;
    bottom: 12px;
    width: 1.5px;
    background: linear-gradient(to bottom, #8FA98A, #E8C4B8, #8FA98A);
    opacity: 0.45;
  }

  .garden-sched__item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    padding: clamp(0.35rem, 1vh, 0.65rem) 0;
  }

  .garden-sched__flower {
    flex-shrink: 0;
    margin-top: 0.05rem;
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FDF8F0;
    border-radius: 50%;
  }

  .garden-sched__content {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .garden-sched__time {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: clamp(0.95rem, 2.2vw, 1.1rem);
    color: #5C7A54;
    font-weight: 600;
  }

  .garden-sched__desc {
    font-family: 'Lora', Georgia, serif;
    font-size: clamp(0.82rem, 1.8vw, 0.92rem);
    color: #3D3D3D;
    margin: 0;
    line-height: 1.4;
    opacity: 0.88;
  }
</style>
